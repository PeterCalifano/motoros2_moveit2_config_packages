<?xml version="1.0" ?>
<robot name="dual_gp12_rail" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find motoman_gp12_support)/urdf/gp12_macro.xacro" />

  <!-- Instantiate both robots -->
  <xacro:motoman_gp12 prefix="group_1/"/>
  <xacro:motoman_gp12 prefix="group_2/"/>

  <!-- World frame -->
  <link name="world"/>

  <!-- Rail size and robot 1 position variables -->
  <xacro:property name="rail_length" value="4.0"/>
  <xacro:property name="rail_width" value="0.5"/>
  <xacro:property name="rail_height" value="0.25"/>
  <xacro:property name="world_to_rail_offset" value="${rail_length+0.5}"/>

  <!-- Rail for Robot 1 -->
  <link name="rail">
    <visual>
      <geometry>
        <box size="${rail_length} ${rail_width} ${rail_height}"/>
      </geometry>
      <origin xyz="0.0 0.0 ${rail_height/2}" rpy="0 0 0"/>
      <material name="rail_grey">
        <color rgba="0.5 0.5 0.5 0.5"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${rail_length} ${rail_width} ${rail_height}"/>
      </geometry>
      <origin xyz="0.0 0.0 ${rail_height/2}" rpy="0 0 0"/>
    </collision>
  </link>

  <joint name="world_to_rail" type="fixed">
    <parent link="world"/>
    <child link="rail"/>
    <origin xyz="${world_to_rail_offset} 0 0" rpy="0 0 3.14159"/>
  </joint>

  <joint name="rail_joint" type="prismatic">
    <parent link="rail"/>
    <child link="group_1/base_link"/>
    <origin xyz="0 0 ${rail_height}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-rail_length/2}" upper="${rail_length/2}" effort="1000.0" velocity="1.0"/>
  </joint>

  <!-- Robot 2 at world origin -->
  <joint name="world_to_robot2" type="fixed">
    <parent link="world"/>
    <child link="group_2/base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
